<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ScreenDemoRecorder</AssemblyName>
    <RootNamespace>ScreenDemoRecorder</RootNamespace>
    <Version>1.0.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <FfmpegRuntimeDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\vendor\ffmpeg'))</FfmpegRuntimeDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(RecorderDiagnostics)' != 'true'">
    <Compile Remove="Diagnostics\**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Vortice 3.8 packages the WIC GIF metadata API with Direct2D1; no Direct2D rendering is used. -->
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
    <ProjectReference Include="..\ScreenDemoRecorder.Core\ScreenDemoRecorder.Core.csproj" />
    <Content Include="$(FfmpegRuntimeDirectory)\*"
             Exclude="$(FfmpegRuntimeDirectory)\ffplay.exe">
      <Link>ffmpeg\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="ValidateVendoredFfmpeg" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_RequiredFfmpegFile Include="ffmpeg.exe;ffprobe.exe;avcodec-63.dll;avdevice-63.dll;avfilter-12.dll;avformat-63.dll;avutil-61.dll;swresample-7.dll;swscale-10.dll;BUILD.txt;COPYING.LGPLv2.1.txt" />
      <_MissingFfmpegFile Include="@(_RequiredFfmpegFile)" Condition="!Exists('$(FfmpegRuntimeDirectory)\%(Identity)')" />
    </ItemGroup>
    <Error Condition="'@(_MissingFfmpegFile)' != ''"
           Text="The local FFmpeg runtime is incomplete. Missing: @(_MissingFfmpegFile, ', ')." />
  </Target>
</Project>
