<Window x:Class="ScreenDemoRecorder.OverlayEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay Editor"
        Width="920"
        Height="650"
        MinWidth="780"
        MinHeight="560"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="310" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Row="0" Grid.Column="0" Margin="18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="PreviewSummary" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" TextWrapping="Wrap" />
            <Viewbox x:Name="PreviewViewport" Grid.Row="1" Stretch="Uniform" SizeChanged="PreviewCanvas_SizeChanged">
                <Canvas x:Name="PreviewCanvas" Background="#202A3C" ClipToBounds="True">
                    <TextBlock Canvas.Left="40" Canvas.Top="30" Text="Capture preview" FontSize="24" Foreground="#AFC0DA" IsHitTestVisible="False" />
                    <Image x:Name="LabelPreview" Stretch="None"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                            MouseMove="Overlay_MouseMove"
                            MouseLeftButtonUp="Overlay_MouseLeftButtonUp" LostMouseCapture="Overlay_LostMouseCapture" />
                    <Border x:Name="SelectedLineOutline" BorderBrush="#E8E1FF" BorderThickness="1" Background="#241B4940" IsHitTestVisible="False" Visibility="Collapsed" />
                    <TextBox x:Name="InlineTextEditor" Visibility="Collapsed" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Center" Padding="3" BorderBrush="#E8E1FF" BorderThickness="2"
                             TextChanged="InlineTextEditor_TextChanged" PreviewKeyDown="InlineTextEditor_PreviewKeyDown"
                             LostKeyboardFocus="InlineTextEditor_LostKeyboardFocus" />
                    <Border x:Name="LabelOutline" BorderBrush="#A18BFF" BorderThickness="1" IsHitTestVisible="False" />
                    <Border x:Name="LabelResizeHandle" Background="#A18BFF" BorderBrush="White" BorderThickness="1" Cursor="SizeWE" ToolTip="Drag to change label width"
                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown" MouseMove="Overlay_MouseMove" MouseLeftButtonUp="Overlay_MouseLeftButtonUp" LostMouseCapture="Overlay_LostMouseCapture" />

                    <Image x:Name="KeystrokePreview" Stretch="None"
                            Cursor="SizeAll"
                            MouseLeftButtonDown="Overlay_MouseLeftButtonDown"
                            MouseMove="Overlay_MouseMove"
                            MouseLeftButtonUp="Overlay_MouseLeftButtonUp" LostMouseCapture="Overlay_LostMouseCapture" />
                    <Image x:Name="ClickPreview" Stretch="None" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" />
                </Canvas>
            </Viewbox>
            <TextBlock Grid.Row="2" Text="Double-click text to edit · drag the label to move · pull the handle to resize&#10;Enter applies · Shift+Enter inserts a line break · Esc cancels" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
        </Grid>

        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <TabControl Background="Transparent" BorderThickness="0" Margin="12">
                <TabItem Header="Label">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,14,4,4">
                            <CheckBox x:Name="LabelEnabledCheckBox" Content="Show label" Margin="0,0,0,14" Checked="LabelSetting_Changed" Unchecked="LabelSetting_Changed" />
                            <TextBlock Text="Style" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                            <ComboBox x:Name="LabelStyleComboBox" SelectionChanged="LabelStyleComboBox_SelectionChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Clean" Tag="Clean" />
                                <ComboBoxItem Content="Glass" Tag="Glass" />
                                <ComboBoxItem Content="Accent" Tag="Accent" />
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                <ComboBoxItem Content="Text only" Tag="TextOnly" />
                                <ComboBoxItem Content="Custom" Tag="Custom" />
                            </ComboBox>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Text rows" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Add row" Padding="9,4" Click="AddLine_Click" />
                            </Grid>
                            <ListBox x:Name="LabelLinesEditor" Background="Transparent" BorderThickness="0" Padding="0"
                                     SelectionChanged="LabelLinesEditor_SelectionChanged" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#352A5B" /></Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,12">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,7,0" Click="LineEnabled_Click" />
                                            <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" TextChanged="LineText_Changed" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                                            <Button Grid.Column="2" Content="×" Width="34" Margin="6,0,0,0" Click="RemoveLine_Click" />
                                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="A−" Tag="-2" Padding="5,3" Click="LineSize_Click" ToolTip="Smaller text" />
                                                <Button Content="A+" Tag="2" Padding="5,3" Margin="3,0,6,0" Click="LineSize_Click" ToolTip="Larger text" />
                                                <CheckBox Content="B" FontWeight="Bold" IsChecked="{Binding IsBold}" Click="LineEnabled_Click" Margin="0,0,8,0" />
                                                <CheckBox Content="I" FontStyle="Italic" IsChecked="{Binding IsItalic}" Click="LineEnabled_Click" Margin="0,0,8,0" />
                                                <Button Content="↑" Tag="-1" Padding="5,3" Click="MoveLine_Click" ToolTip="Move row up" />
                                                <Button Content="↓" Tag="1" Padding="5,3" Margin="3,0,0,0" Click="MoveLine_Click" ToolTip="Move row down" />
                                            </StackPanel>
                                            <Expander Grid.Row="2" Grid.ColumnSpan="3" Header="Text style" Margin="0,5,0,0">
                                                <StackPanel Margin="0,6,0,0">
                                                    <ComboBox IsEditable="True" Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" LostKeyboardFocus="LineStyle_Changed" SelectionChanged="LineStyle_Changed" ToolTip="Font family or a .ttf/.otf file path">
                                                        <ComboBoxItem Content="Segoe UI Variable" /><ComboBoxItem Content="Arial" /><ComboBoxItem Content="Consolas" /><ComboBoxItem Content="Georgia" />
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding Size, StringFormat=Size: {0:0} px}" Margin="0,6,0,0" />
                                                    <Slider Minimum="6" Maximum="300" SmallChange="1" LargeChange="4" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Size}" ValueChanged="LineStyle_Changed" />
                                                    <ComboBox SelectedValuePath="Tag" SelectedValue="{Binding Alignment}" SelectionChanged="LineStyle_Changed" Margin="0,5,0,5">
                                                        <ComboBoxItem Content="Left aligned" Tag="left" /><ComboBoxItem Content="Centered" Tag="center" /><ComboBoxItem Content="Right aligned" Tag="right" />
                                                    </ComboBox>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="White" Tag="#FFFFFFFF" Padding="6,3" Click="LineColor_Click" />
                                                        <Button Content="Dark" Tag="#17191EFF" Padding="6,3" Margin="4,0,0,0" Click="LineColor_Click" />
                                                        <Button Content="Yellow" Tag="#FFDA88FF" Padding="6,3" Margin="4,0,0,0" Click="LineColor_Click" />
                                                    </StackPanel>
                                                    <TextBlock Text="Exact text color" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3" />
                                                    <TextBox Text="{Binding Color, Mode=OneWay}" Tag="Color" LostKeyboardFocus="LineExactColor_Changed" ToolTip="#RRGGBB or #RRGGBBAA" />
                                                    <TextBlock Text="{Binding StrokeWidth, StringFormat=Outline: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                                                    <Slider Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Tag="StrokeWidth"
                                                            Value="{Binding StrokeWidth, UpdateSourceTrigger=PropertyChanged}" ValueChanged="LineStyle_Changed" />
                                                    <TextBlock Text="Outline color" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,3" />
                                                    <TextBox Text="{Binding StrokeColor, Mode=OneWay}" Tag="StrokeColor" LostKeyboardFocus="LineExactColor_Changed" ToolTip="#RRGGBB or #RRGGBBAA" />
                                                    <TextBlock Text="Text shadow" FontWeight="SemiBold" Margin="0,10,0,3" />
                                                    <TextBlock Text="Shadow color" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,3" />
                                                    <TextBox Text="{Binding ShadowColor, Mode=OneWay}" Tag="ShadowColor" LostKeyboardFocus="LineExactColor_Changed" ToolTip="#RRGGBB or #RRGGBBAA" />
                                                    <TextBlock Text="{Binding ShadowBlur, StringFormat=Shadow blur: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Tag="ShadowBlur"
                                                            Value="{Binding ShadowBlur, UpdateSourceTrigger=PropertyChanged}" ValueChanged="LineStyle_Changed" />
                                                    <TextBlock Text="{Binding ShadowOffsetX, StringFormat=Shadow X: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                                    <Slider Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Tag="ShadowOffsetX"
                                                            Value="{Binding ShadowOffsetX, UpdateSourceTrigger=PropertyChanged}" ValueChanged="LineStyle_Changed" />
                                                    <TextBlock Text="{Binding ShadowOffsetY, StringFormat=Shadow Y: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                                    <Slider Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Tag="ShadowOffsetY"
                                                            Value="{Binding ShadowOffsetY, UpdateSourceTrigger=PropertyChanged}" ValueChanged="LineStyle_Changed" />
                                                </StackPanel>
                                            </Expander>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Label width" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,3" />
                            <Slider x:Name="LabelWidthSlider" Minimum="80" Maximum="7680" SmallChange="8" LargeChange="40" ValueChanged="LabelWidth_Changed" />

                            <TextBlock Text="Quick position" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,6" />
                            <UniformGrid Columns="3" Rows="3" Width="120" HorizontalAlignment="Left">
                                <Button Content="↖" Tag="TopLeft" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="↑" Tag="TopCenter" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="↗" Tag="TopRight" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="←" Tag="CenterLeft" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="•" Tag="Center" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="→" Tag="CenterRight" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="↙" Tag="BottomLeft" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="↓" Tag="BottomCenter" Padding="4" Click="LabelAnchor_Click" />
                                <Button Content="↘" Tag="BottomRight" Padding="4" Click="LabelAnchor_Click" />
                            </UniformGrid>

                            <Expander x:Name="AdvancedLabelExpander" Header="Advanced label appearance" Margin="0,14,0,0">
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Text="Colors" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="Background" VerticalAlignment="Center" />
                                        <TextBox x:Name="LabelBackgroundColorBox" Grid.Column="1" Margin="6,2" TextChanged="AdvancedLabel_Changed" ToolTip="#RRGGBB or #RRGGBBAA" />
                                        <TextBlock Grid.Row="1" Text="Border" VerticalAlignment="Center" />
                                        <TextBox x:Name="LabelBorderColorBox" Grid.Row="1" Grid.Column="1" Margin="6,2" TextChanged="AdvancedLabel_Changed" ToolTip="#RRGGBB or #RRGGBBAA" />
                                        <TextBlock Grid.Row="2" Text="Shadow" VerticalAlignment="Center" />
                                        <TextBox x:Name="LabelShadowColorBox" Grid.Row="2" Grid.Column="1" Margin="6,2" TextChanged="AdvancedLabel_Changed" ToolTip="#RRGGBB or #RRGGBBAA" />
                                    </Grid>
                                    <TextBlock x:Name="AdvancedLabelError" Foreground="#FF8585" TextWrapping="Wrap" Margin="0,3,0,5" />

                                    <TextBlock Text="{Binding ElementName=LabelPaddingXSlider, Path=Value, StringFormat=Horizontal padding: {0:0} px}" Foreground="{DynamicResource MutedBrush}" />
                                    <Slider x:Name="LabelPaddingXSlider" Minimum="0" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelPaddingYSlider, Path=Value, StringFormat=Vertical padding: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelPaddingYSlider" Minimum="0" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelLineGapSlider, Path=Value, StringFormat=Row gap: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelLineGapSlider" Minimum="0" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelCornerRadiusSlider, Path=Value, StringFormat=Corner radius: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelCornerRadiusSlider" Minimum="0" Maximum="500" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelBorderWidthSlider, Path=Value, StringFormat=Border: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelBorderWidthSlider" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelBackgroundBlurSlider, Path=Value, StringFormat=Background blur: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelBackgroundBlurSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelShadowBlurSlider, Path=Value, StringFormat=Shadow blur: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelShadowBlurSlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelShadowXSlider, Path=Value, StringFormat=Shadow X: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelShadowXSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                    <TextBlock Text="{Binding ElementName=LabelShadowYSlider, Path=Value, StringFormat=Shadow Y: {0:0} px}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                    <Slider x:Name="LabelShadowYSlider" Minimum="-100" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="AdvancedLabel_Changed" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="KeystrokesTab" Header="Pressed keys">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,14,4,4">
                            <CheckBox x:Name="KeystrokesEnabledCheckBox" Content="Show pressed keys" Margin="0,0,0,14" Checked="KeystrokeSetting_Changed" Unchecked="KeystrokeSetting_Changed" />
                            <TextBlock Text="Captured only during recording, never on pause. No keyboard history is saved. All-keys mode can expose sensitive input in the video." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Display" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                            <ComboBox x:Name="KeystrokeModeComboBox" SelectionChanged="KeystrokeModeComboBox_SelectionChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Shortcuts only" Tag="ShortcutsOnly" />
                                <ComboBoxItem Content="Non-text keys" Tag="NonTextKeys" />
                                <ComboBoxItem Content="All keys" Tag="AllKeys" />
                            </ComboBox>
                            <TextBlock Text="Style" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                            <ComboBox x:Name="KeystrokeStyleComboBox" SelectionChanged="KeystrokeStyleComboBox_SelectionChanged" Margin="0,0,0,14">
                                <ComboBoxItem Content="Dark" Tag="Dark" />
                                <ComboBoxItem Content="Light" Tag="Light" />
                                <ComboBoxItem Content="Accent" Tag="Accent" />
                                <ComboBoxItem Content="Minimal" Tag="Minimal" />
                                <ComboBoxItem Content="Custom (dark)" Tag="Custom" />
                            </ComboBox>
                            <TextBlock Text="{Binding ElementName=KeystrokeScaleSlider, Path=Value, StringFormat=Size: {0:0.0}×}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="KeystrokeScaleSlider" Minimum="0.5" Maximum="3" TickFrequency="0.1" ValueChanged="KeystrokeSetting_Changed" Margin="0,3,0,12" />
                            <TextBlock Text="{Binding ElementName=KeystrokeDurationSlider, Path=Value, StringFormat=Visible duration: {0:0} ms}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="KeystrokeDurationSlider" Minimum="250" Maximum="10000" TickFrequency="50" ValueChanged="KeystrokeSetting_Changed" Margin="0,3,0,12" />
                            <TextBlock Text="{Binding ElementName=KeystrokeStackSlider, Path=Value, StringFormat=Recent shortcuts: {0:0}}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="KeystrokeStackSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="KeystrokeSetting_Changed" Margin="0,3,0,12" />
                            <CheckBox x:Name="MergeCombinationsCheckBox" Content="Merge quick repeats" Margin="0,0,0,9" Checked="KeystrokeSetting_Changed" Unchecked="KeystrokeSetting_Changed" />
                            <CheckBox x:Name="HideTypingCheckBox" Content="Hide normal typing" Margin="0,0,0,9" Checked="KeystrokeSetting_Changed" Unchecked="KeystrokeSetting_Changed" />
                            <CheckBox x:Name="HideRecorderHotkeysCheckBox" Content="Hide recorder control shortcuts" Margin="0,0,0,14" Checked="KeystrokeSetting_Changed" Unchecked="KeystrokeSetting_Changed" />
                            <Expander x:Name="AdvancedKeystrokeExpander" Header="Advanced timing and opacity" Margin="0,0,0,12">
                                <StackPanel Margin="0,7,0,0">
                                    <TextBlock Text="{Binding ElementName=KeystrokeOpacitySlider, Path=Value, StringFormat=Opacity: {0:0.00}}" Foreground="{DynamicResource MutedBrush}" />
                                    <Slider x:Name="KeystrokeOpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" ValueChanged="KeystrokeSetting_Changed" />
                                    <TextBlock Text="{Binding ElementName=KeystrokeFadeSlider, Path=Value, StringFormat=Fade duration: {0:0} ms}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                    <Slider x:Name="KeystrokeFadeSlider" Minimum="0" Maximum="5000" TickFrequency="50" ValueChanged="KeystrokeSetting_Changed" />
                                    <TextBlock Text="{Binding ElementName=KeystrokeMergeWindowSlider, Path=Value, StringFormat=Repeat merge window: {0:0} ms}" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
                                    <Slider x:Name="KeystrokeMergeWindowSlider" Minimum="0" Maximum="1000" TickFrequency="25" ValueChanged="KeystrokeSetting_Changed" />
                                </StackPanel>
                            </Expander>
                            <Button Content="Test keystroke animation" Click="TestKeystrokes_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem x:Name="ClicksTab" Header="Mouse clicks">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,14,4,4">
                            <CheckBox x:Name="ClicksEnabledCheckBox" Content="Highlight mouse clicks" Margin="0,0,0,12"
                                      Checked="ClickSetting_Changed" Unchecked="ClickSetting_Changed" />
                            <TextBlock Text="A colored ring expands from the real pointer position. Clicks outside the recorded area are ignored, and paused clicks are never retained."
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Quick colors" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                            <WrapPanel Margin="0,0,0,12">
                                <Button Content="Violet + amber" Tag="Violet" Padding="7,3" Click="ClickPreset_Click" />
                                <Button Content="Blue + red" Tag="Blue" Padding="7,3" Margin="4,0,0,0" Click="ClickPreset_Click" />
                                <Button Content="High contrast" Tag="Contrast" Padding="7,3" Margin="4,0,0,0" Click="ClickPreset_Click" />
                            </WrapPanel>
                            <TextBlock Text="{Binding ElementName=ClickSizeSlider, Path=Value, StringFormat=Ring size: {0:0} px}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="ClickSizeSlider" Minimum="16" Maximum="160" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ClickSetting_Changed" Margin="0,3,0,10" />
                            <TextBlock Text="{Binding ElementName=ClickWidthSlider, Path=Value, StringFormat=Ring width: {0:0} px}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="ClickWidthSlider" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="ClickSetting_Changed" Margin="0,3,0,10" />
                            <TextBlock Text="{Binding ElementName=ClickDurationSlider, Path=Value, StringFormat=Animation: {0:0} ms}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="ClickDurationSlider" Minimum="150" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="ClickSetting_Changed" Margin="0,3,0,10" />
                            <TextBlock Text="{Binding ElementName=ClickOpacitySlider, Path=Value, StringFormat=Opacity: {0:0.00}}" Foreground="{DynamicResource MutedBrush}" />
                            <Slider x:Name="ClickOpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.05" ValueChanged="ClickSetting_Changed" Margin="0,3,0,12" />
                            <Expander x:Name="AdvancedClickExpander" Header="Exact left and right colors" Margin="0,0,0,12">
                                <StackPanel Margin="0,7,0,0">
                                    <TextBlock Text="Left click" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,3" />
                                    <TextBox x:Name="LeftClickColorBox" LostKeyboardFocus="ClickColor_LostFocus" ToolTip="#RRGGBB or #RRGGBBAA" />
                                    <TextBlock Text="Right click" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,3" />
                                    <TextBox x:Name="RightClickColorBox" LostKeyboardFocus="ClickColor_LostFocus" ToolTip="#RRGGBB or #RRGGBBAA" />
                                    <TextBlock x:Name="ClickColorError" Foreground="#FF8585" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Expander>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Content="Test left click" Tag="Left" Click="TestClick_Click" />
                                <Button Grid.Column="1" Content="Test right click" Tag="Right" Click="TestClick_Click" Margin="6,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="Save overlays" Width="120" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
