<Window x:Class="ScreenDemoRecorder.CaptureSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Capture" Width="520" Height="650" MinWidth="460" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Advanced capture" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Use presets for common values or type an exact value. These settings stay with the active profile."
                       Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <GroupBox Header="Frame rate">
                    <StackPanel>
                        <CheckBox x:Name="AutomaticFpsCheck" Content="Automatic · currently targets 30 fps"
                                  Checked="AutomaticFpsChanged" Unchecked="AutomaticFpsChanged" Margin="0,0,0,10" />
                        <TextBlock Text="Exact recording FPS" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="RecordingFpsCombo" IsEditable="True"
                                  ToolTip="Choose a preset or type a value from 1 to 120 fps">
                            <ComboBoxItem Content="15 fps · light" Tag="15" />
                            <ComboBoxItem Content="24 fps · cinematic" Tag="24" />
                            <ComboBoxItem Content="30 fps · standard" Tag="30" />
                            <ComboBoxItem Content="60 fps · smooth" Tag="60" />
                            <ComboBoxItem Content="120 fps · maximum" Tag="120" />
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Timing">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Countdown · seconds" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                            <ComboBox x:Name="CountdownCombo" IsEditable="True" ToolTip="0 to 10 seconds">
                                <ComboBoxItem Content="Off" Tag="0" />
                                <ComboBoxItem Content="3 seconds" Tag="3" />
                                <ComboBoxItem Content="5 seconds" Tag="5" />
                                <ComboBoxItem Content="10 seconds" Tag="10" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Stop after · seconds" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                            <ComboBox x:Name="DurationCombo" IsEditable="True" ToolTip="0 means no limit; maximum 86400 seconds">
                                <ComboBoxItem Content="No limit" Tag="0" />
                                <ComboBoxItem Content="30 seconds" Tag="30" />
                                <ComboBoxItem Content="1 minute" Tag="60" />
                                <ComboBoxItem Content="5 minutes" Tag="300" />
                                <ComboBoxItem Content="15 minutes" Tag="900" />
                                <ComboBoxItem Content="1 hour" Tag="3600" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox Header="Region behavior">
                    <StackPanel>
                        <CheckBox x:Name="LockAspectCheck" Content="Lock aspect ratio while resizing" Margin="0,0,0,10" />
                        <TextBlock Text="Quick aspect ratios" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="16:9" Tag="16:9" Click="AspectPreset_Click" Padding="8,3" />
                            <Button Content="4:3" Tag="4:3" Click="AspectPreset_Click" Padding="8,3" Margin="5,0,0,0" />
                            <Button Content="1:1" Tag="1:1" Click="AspectPreset_Click" Padding="8,3" Margin="5,0,0,0" />
                            <Button Content="9:16" Tag="9:16" Click="AspectPreset_Click" Padding="8,3" Margin="5,0,0,0" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Aspect width" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="AspectWidthBox" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text=":" FontSize="18" VerticalAlignment="Bottom" Margin="8,0" Padding="0,0,0,4" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Aspect height" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                                <TextBox x:Name="AspectHeightBox" />
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="SnapCheck" Content="Snap the region to display edges" Margin="0,0,0,10" />
                        <TextBlock Text="Minimum region size · pixels" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5" />
                        <ComboBox x:Name="MinimumSizeCombo" IsEditable="True" ToolTip="Choose or type a value from 16 to 1000 pixels">
                            <ComboBoxItem Content="16 px · precise" Tag="16" />
                            <ComboBoxItem Content="32 px · default" Tag="32" />
                            <ComboBoxItem Content="64 px" Tag="64" />
                            <ComboBoxItem Content="128 px" Tag="128" />
                        </ComboBox>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FF9CA7" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="Save settings" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="1" Content="Cancel" IsCancel="True" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
