<Window x:Class="ScreenDemoRecorder.GifSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF Export" Width="520" Height="590" MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="GIF export" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="Your label and pressed keys stay in the animation." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Size and motion">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="WidthCombo" IsEditable="True" SelectionChanged="SettingChanged" LostKeyboardFocus="SettingChanged" ToolTip="Choose a preset or type an exact width, from 64 to 7680 pixels">
                                <ComboBoxItem Content="Small · 640 px" Tag="640" />
                                <ComboBoxItem Content="Balanced · 960 px" Tag="960" />
                                <ComboBoxItem Content="Sharp · 1280 px" Tag="1280" />
                                <ComboBoxItem Content="Full HD · 1920 px" Tag="1920" />
                            </ComboBox>
                            <Button Grid.Column="1" Content="Match capture" Margin="8,0,0,0" Click="MatchCapture_Click" />
                        </Grid>
                        <TextBlock x:Name="SizeSummary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Motion" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="GifFpsCombo" Grid.Column="1" IsEditable="True" SelectionChanged="SettingChanged" LostKeyboardFocus="SettingChanged" ToolTip="Choose a preset or type an exact rate, from 1 to 60 fps">
                                <ComboBoxItem Content="Light · 8 fps" Tag="8" />
                                <ComboBoxItem Content="Balanced · 12 fps" Tag="12" />
                                <ComboBoxItem Content="Smooth · 20 fps" Tag="20" />
                                <ComboBoxItem Content="Very smooth · 25 fps" Tag="25" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Color and playback">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Colors" Margin="0,0,0,5" />
                                <ComboBox x:Name="PaletteCombo" IsEditable="True" ToolTip="Choose or type a palette size from 2 to 256 colors">
                                    <ComboBoxItem Content="64 · Smaller" Tag="64" />
                                    <ComboBoxItem Content="128 · Balanced" Tag="128" />
                                    <ComboBoxItem Content="256 · More detail" Tag="256" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Repeat" Margin="0,0,0,5" />
                                <ComboBox x:Name="LoopCombo" IsEditable="True" ToolTip="0 = forever; otherwise repeat 1 to 10000 times after the first play">
                                    <ComboBoxItem Content="Forever" Tag="0" />
                                    <ComboBoxItem Content="Repeat once" Tag="1" />
                                    <ComboBoxItem Content="Repeat 3 times" Tag="3" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <CheckBox x:Name="DitherCheck" Content="Smooth color gradients (dithering)" Margin="0,12,0,0" />
                    </StackPanel>
                </GroupBox>
                <CheckBox x:Name="KeepSourceCheck" Content="Also keep the MP4" Margin="2,0,0,5" />
                <TextBlock Text="If GIF export fails or is cancelled, the MP4 is always kept." Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,12" />
                <Expander x:Name="AdvancedExpander" Header="Advanced" Foreground="{DynamicResource TextBrush}">
                    <StackPanel Margin="2,12,2,8">
                        <TextBlock Text="Frame sampling" Margin="0,0,0,5" />
                        <ComboBox x:Name="StepCombo" IsEditable="True" SelectionChanged="SettingChanged" LostKeyboardFocus="SettingChanged" ToolTip="Keep every Nth GIF frame, from 1 to 30. Playback speed stays the same.">
                            <ComboBoxItem Content="Every frame" Tag="1" />
                            <ComboBoxItem Content="Every 2nd frame" Tag="2" />
                            <ComboBoxItem Content="Every 3rd frame" Tag="3" />
                        </ComboBox>
                        <TextBlock Text="Last-frame duration" Margin="0,12,0,5" />
                        <ComboBox x:Name="HoldCombo" IsEditable="True" ToolTip="Choose a duration or type milliseconds, from 0 to 60000. 0 keeps normal timing.">
                            <ComboBoxItem Content="Normal timing" Tag="0" />
                            <ComboBoxItem Content="0.5 seconds" Tag="500" />
                            <ComboBoxItem Content="1 second" Tag="1000" />
                            <ComboBoxItem Content="2 seconds" Tag="2000" />
                        </ComboBox>
                        <TextBlock Text="Filename" Margin="0,12,0,5" />
                        <TextBox x:Name="FilenameBox" />
                        <TextBlock Text="Tokens: {date}, {time}, {title}, {counter}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,12" />
                        <CheckBox x:Name="OpenFolderCheck" Content="Open the folder after saving" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#FF9CA7" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10" />
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="Save settings" Click="Save_Click" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="1" Content="Cancel" IsCancel="True" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>
    </Grid>
</Window>
