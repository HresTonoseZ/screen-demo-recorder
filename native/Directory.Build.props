<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RecorderDiagnostics)' == 'true'">
    <DefineConstants>$(DefineConstants);RECORDER_DIAGNOSTICS</DefineConstants>
    <BaseIntermediateOutputPath>obj\diagnostic\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\diagnostic\</BaseOutputPath>
  </PropertyGroup>
</Project>
