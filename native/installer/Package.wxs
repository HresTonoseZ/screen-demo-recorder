<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Screen Demo Recorder"
           Manufacturer="HresTonoseZ"
           Version="$(var.ProductVersion)"
           UpgradeCode="67C7F2A7-5181-43F2-8FF0-97D51C09A3EE"
           Scope="perUser"
           InstallerVersion="500"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Screen Demo Recorder is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Component Id="LocalProgramsFolderCleanup" Guid="DF0FF36A-FE78-4586-B49F-147C947E7A8D">
          <RemoveFolder Id="RemoveLocalProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Screen Demo Recorder"
                         Name="LocalProgramsFolder"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
        <Directory Id="INSTALLFOLDER" Name="Screen Demo Recorder" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Screen Demo Recorder">
        <Component Id="StartMenuShortcut" Guid="13CD832D-27FB-4452-A5AE-B556AC6134B4">
          <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="Screen Demo Recorder"
                    Description="Record polished screen demos to MP4 or GIF"
                    Target="[INSTALLFOLDER]ScreenDemoRecorder.exe"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU"
                         Key="Software\Screen Demo Recorder"
                         Name="StartMenuShortcut"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Screen Demo Recorder" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="LocalProgramsFolderCleanup" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

</Wix>
